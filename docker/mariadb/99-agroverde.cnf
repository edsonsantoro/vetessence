# ---------------------------------------------------------------------------
# AgroVerde — Configuração MariaDB
# Baseado em docs/performance.md (guia de otimização do VetEssence)
# ---------------------------------------------------------------------------

[mysqld]
# --- InnoDB Buffer Pool (principal gargalo identificado no guia) ---
# Dev: 512M é suficiente. Produção (4GB RAM): 1.5G
innodb_buffer_pool_size = 512M
innodb_log_file_size = 128M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1

# --- Conexões ---
max_connections = 100

# --- Charset ---
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# --- Query cache (desabilitado no MariaDB 10.11+, mantido por compatibilidade) ---
query_cache_type = 0
query_cache_size = 0

# --- Slow query log (ajuda a identificar gargalos) ---
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 2

[client]
default-character-set = utf8mb4
